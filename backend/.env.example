DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=rets
PORT=5001

# Comma-separated L_Type_ values that count as rental/lease listings for the Rent search.
# Check `SELECT DISTINCT L_Type_ FROM rets_property` against your MLS feed and adjust.
RENTAL_PROPERTY_TYPES=ResidentialLease,Apartment
